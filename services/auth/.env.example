# Gatekeeper Auth Service - Local Environment Template
# Copy this file to .env and adjust variables as needed:
#   Copy-Item .env.example .env

# Database connection URL (PostgreSQL)
# Unified on standard port 5432 and bound strictly to loopback (127.0.0.1)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
DATABASE_URL=postgres://gatekeeper:secretpassword@127.0.0.1:5432/gatekeeper_auth?sslmode=disable

# HTTP server bind address (bound strictly to loopback 127.0.0.1 to avoid exposing dev port to LAN)
HTTP_ADDR=127.0.0.1:8080

# Timeout for connecting to PostgreSQL and health pings (default: 5s)
DB_CONNECT_TIMEOUT=5s

# Timeout for individual database query executions (default: 3s)
DB_QUERY_TIMEOUT=3s

# Graceful shutdown timeout before forced connection termination (default: 10s)
HTTP_SHUTDOWN_TIMEOUT=10s

# Maximum concurrent Argon2id password hashing operations per instance (1-32, default: 2)
# Each Argon2id operation uses ~64 MiB of RAM; keep this bounded to prevent memory exhaustion
PASSWORD_HASH_CONCURRENCY=2

# JWT and Key Configuration
# Issuer and audience strings embedded in issued access tokens
JWT_ISSUER=gatekeeper-auth
JWT_AUDIENCE=gatekeeper-services

# Active Key ID identifying the current signing key in JWT header and JWKS
JWT_ACTIVE_KID=key-2026-1

# Path to the PKCS#8 Ed25519 private key PEM file (runtime secret, never committed)
JWT_PRIVATE_KEY_FILE=keys/ed25519_private.pem

# Optional path to archived public keys in JWKS format for graceful key rotation
# JWT_PUBLIC_KEYS_FILE=keys/archived_jwks.json

# Access token lifetime (1m to 15m, default: 10m)
ACCESS_TOKEN_TTL=10m

# Rate limit for login attempts per remote IP (default: 10 attempts per 1 minute window)
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=1m

# Refresh session lifetime (24h to 720h, default: 720h / 30 days)
REFRESH_SESSION_TTL=720h

# SMTP Email Delivery Configuration
# STARTTLS and certificate verification are strictly required. Plaintext transmission is rejected.
# For local development with Mailpit:
# 1. Generate a local test certificate with SAN (using Git OpenSSL on Windows or OpenSSL in Docker):
#    & "C:\Program Files\Git\usr\bin\openssl.exe" req -x509 -newkey rsa:2048 -nodes -keyout certs/mailpit.key -out certs/mailpit.crt -days 365 -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
# 2. Run Mailpit with TLS enabled:
#    mailpit --smtp-tls-cert certs/mailpit.crt --smtp-tls-key certs/mailpit.key --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gatekeeper.local
# Path to trusted CA/certificate for local SMTP server (optional in production where system root CAs are used):
SMTP_CA_FILE=certs/mailpit.crt
SMTP_SEND_TIMEOUT=10s

# Email Verification Token Configuration
# Token lifetime before expiration (1h to 168h, default: 24h)
EMAIL_VERIFICATION_TOKEN_TTL=24h
# Cooldown between resend requests for the same account (10s to 10m, default: 60s)
EMAIL_VERIFICATION_COOLDOWN=60s
